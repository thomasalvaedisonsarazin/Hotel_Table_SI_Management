# Copy to .env and change these values.
DB_USER=dineops
DB_PASSWORD=change-me
DB_NAME=dineops
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# SMS and WhatsApp alerts. "log" records messages without sending anything.
# To send for real, set NOTIFICATION_PROVIDER=twilio and fill in the rest. See the README.
NOTIFICATION_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Throwaway account for local browser testing only. Never use it on a deployed site.
# E2E_EMAIL=e2e@example.com
# E2E_PASSWORD=local-e2e-only-9f3k
